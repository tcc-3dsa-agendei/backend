  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "pg": "8.23.0"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@brazilian-utils/brazilian-utils": "2.4.0",
    "@elysia/cors": "1.4.2",
